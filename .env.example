# Set to https://relevaint.io once its domain is connected to this deployment.
SITE_URL=https://relevaint-web.vercel.app
# Optional until the Relevaint database is chosen and db/inquiries-setup.sql is run.
# With these absent, visitors get functional email/booking links instead of a broken form.
SUPABASE_URL=
# Server-only sb_secret_ key, never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
